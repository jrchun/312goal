# 이 파일을 복사해서 .env.local 로 만들고 값을 채운다 (.env.local 은 git에 안 올라감).
# Supabase 대시보드 → Project Settings → API (또는 Data API) 에서 확인.
EXPO_PUBLIC_SUPABASE_URL=https://hfnwadutbowgxrosnypz.supabase.co
# "anon public" 키 (또는 새 형식 "publishable" 키). 공개돼도 되는 키. service_role 키는 절대 넣지 말 것.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 배포 주소 (앱에서 초대 링크 만들 때 사용). 웹은 열린 주소를 자동으로 씀
EXPO_PUBLIC_SITE_URL=http://localhost:8081
